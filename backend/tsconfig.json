{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "_comment": "Tests are run by `npm test` through tsx, not compiled -- they would otherwise ship inside dist/ and be started by `npm start`.",
  "exclude": ["src/**/*.test.ts"]
}

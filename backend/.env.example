# Copy to .env (gitignored) and adjust as needed. Every major LLM provider (OpenAI, Anthropic's
# compat endpoint, Ollama, Gemini, Grok, ...) speaks the OpenAI-compatible chat completions API,
# so switching provider is just these three values -- no code changes. Defaults in llm.ts already
# target a local Ollama instance, so this file is optional unless you want to override something.

# Base URL of an OpenAI-compatible chat completions endpoint.
# Default (if unset): http://localhost:11434/v1  (local Ollama)
LLM_BASE_URL=http://localhost:11434/v1

# API key. Ollama ignores the value but the SDK requires a non-empty string.
# Default (if unset): ollama
LLM_API_KEY=ollama

# Model tag. Must be a model you've actually pulled (`ollama pull <tag>`) -- check with
# `ollama list` or `curl http://localhost:11434/api/tags` if unsure. A mismatch here causes
# every LLM feature (Explain the pick, research digest, the Settings "Test LLM" button) to fail.
# Default (if unset): qwen3:14b
LLM_MODEL=qwen3:14b
